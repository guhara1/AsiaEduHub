---
import BaseLayout from '~/layouts/BaseLayout.astro';
import AuthorByline from '~/components/AuthorByline.astro';
import { BUDGET_TIERS, TIER_META, budgetSchoolsByTier, formatUsdRange, type BudgetTier } from '~/lib/budget';

export async function getStaticPaths() {
  return BUDGET_TIERS.map((tier) => ({ params: { tier }, props: { tier } }));
}

const { tier } = Astro.props as { tier: BudgetTier };
const meta = TIER_META[tier];
const schools = budgetSchoolsByTier(tier);

const publishedAt = new Date('2026-07-05');
const updatedAt = new Date('2026-07-05');

const title = `${meta.ko} 국제학교 — ${meta.range_ko} | 동남아 예산별 추천 · AsiaEduHub`;
const description = `${meta.range_ko} 구간 동남아 국제학교 ${schools.length}곳. 말레이시아·태국·베트남·싱가포르 학교를 학비 기준으로 정리 — 학교별 상세에서 커리큘럼·한국인 비율 확인.`;

const siteRoot = Astro.site?.toString() ?? '';
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AsiaEduHub', item: siteRoot + '' },
    { '@type': 'ListItem', position: 2, name: '예산별 학교', item: siteRoot + 'tools/budget/budget-friendly/' },
    { '@type': 'ListItem', position: 3, name: `${meta.ko} (${meta.range_ko})` },
  ],
};
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: `${meta.ko} 동남아 국제학교`,
  numberOfItems: schools.length,
  itemListElement: schools.map((s, i) => ({
    '@type': 'ListItem', position: i + 1, name: s.name_ko, item: siteRoot + s.url.replace(/^\//, ''),
  })),
};
---
<BaseLayout
  title={title} description={description}
  jsonLd={[breadcrumb, itemList]}
  author={{ name: '데이비드', url: '/about/' }}
  publishedAt={publishedAt} updatedAt={updatedAt}
>
  <section class="hero-gradient">
    <div class="container-content py-10 sm:py-12">
      <nav class="text-sm" style="color: var(--color-text-secondary)">
        <a href="/">홈</a> · 예산별 학교 · <span style="color: var(--color-text-primary)">{meta.ko}</span>
      </nav>
      <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl text-balance" style="font-weight:800; letter-spacing:-0.02em">
        {meta.emoji} {meta.ko} 국제학교
      </h1>
      <p class="mt-2 text-lg" style="color: var(--color-primary-700); font-weight:600">{meta.range_ko}</p>
      <p class="mt-3 max-w-2xl text-base" style="color: var(--color-text-secondary); line-height: 1.7;">{meta.intro_ko}</p>
      <p class="mt-3 max-w-2xl text-sm" style="color: var(--color-text-secondary); line-height: 1.75;">{meta.detail_ko}</p>
      <div class="mt-5">
        <AuthorByline locale="ko" publishedAt={publishedAt} updatedAt={updatedAt}
          sources="학교 공식 학비 자료 + 운영자 확인 (동남아 4개국 종합)" />
      </div>
    </div>
  </section>

  <article class="container-content py-10 max-w-4xl">
    {/* 다른 예산 구간 전환 */}
    <div class="flex flex-wrap gap-2 mb-8">
      {BUDGET_TIERS.map((t) => (
        <a href={`/tools/budget/${t}/`}
          class={t === tier ? 'badge-navy' : 'rounded-full border px-3 py-1 text-xs'}
          style={t === tier ? '' : 'border-color: var(--color-border-medium); color: var(--color-text-secondary)'}>
          {TIER_META[t].emoji} {TIER_META[t].ko}
        </a>
      ))}
    </div>

    {schools.length === 0 ? (
      <p class="text-sm" style="color: var(--color-text-secondary)">이 구간의 학교 데이터를 준비 중입니다.</p>
    ) : (
      <div class="grid gap-3 sm:grid-cols-2">
        {schools.map((s) => (
          <a href={s.url} class="block rounded-xl border p-4 transition-colors hover:border-primary-700" style="border-color: var(--color-border-light)">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs" style="color: var(--color-text-tertiary)">{s.flag} {s.country_ko}</span>
              <span class="text-xs" style="color: var(--color-primary-700); font-weight:600; font-variant-numeric: tabular-nums">{formatUsdRange(s.tuition)}</span>
            </div>
            <div class="mt-1.5 text-primary-900" style="font-weight:600; letter-spacing:-0.01em">{s.name_ko}</div>
          </a>
        ))}
      </div>
    )}

    <p class="mt-6 text-xs" style="color: var(--color-text-tertiary)">
      ※ 학비는 학교 공식 자료 기준 연간 범위(USD)이며 학년·환율에 따라 달라집니다. 지원비·등록비·통학 등 부대비용은 별도입니다 —
      <a href="/blog/2026-07-hidden-school-costs/" class="underline">숨은 비용 7가지</a> 참고.
    </p>

    <section class="mt-10 card-cta">
      <h2 class="text-xl text-white" style="font-weight:500">예산에 맞는 학교 상담</h2>
      <p class="mt-3 text-sm">예산 · 자녀 학년 · 희망 지역을 알려주시면 이 구간에서 맞는 학교를 1:1로 추려드립니다.</p>
      <a href="/contact/" class="mt-5 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-primary-900" style="font-weight:500">
        카카오톡 · 이메일 상담
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </a>
    </section>

    <section class="mt-8">
      <div class="text-xs uppercase tracking-wide mb-3" style="color: var(--color-text-tertiary); font-weight:600">함께 보기</div>
      <div class="grid gap-2 sm:grid-cols-2 text-sm">
        <a href="/tools/calculator/" class="card text-sm block">학비 계산기 — 총비용·환율</a>
        <a href="/blog/2026-07-hidden-school-costs/" class="card text-sm block">국제학교 숨은 비용 7가지</a>
        <a href="/blog/2026-07-what-is-international-school/" class="card text-sm block">국제학교란? 세 종류 차이</a>
        <a href="/abroad/malaysia/" class="card text-sm block">말레이시아 국제학교 34곳</a>
      </div>
    </section>
  </article>
</BaseLayout>
