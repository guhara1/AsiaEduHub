---
import BaseLayout from '~/layouts/BaseLayout.astro';
import AuthorByline from '~/components/AuthorByline.astro';
import TuitionCalculator from '~/components/react/TuitionCalculator.tsx';
const publishedAt = new Date('2026-05-21');
const updatedAt = new Date('2026-05-21');
const title = '国际学校学费计算器 — 汇率 · 寄宿 · 机票 · 附加费用一站式模拟 | AsiaEduHub';
const description = '不仅学费,还含注册费 · 保证金 · 校服 · 校车 · CCA · 餐费 · 考试费 · 韩国往返机票的家庭总成本模拟。MYR · KRW · USD 汇率波动反映。';
---
<BaseLayout title={title} description={description} author={{ name: 'David', url: '/zh/about/' }} publishedAt={publishedAt} updatedAt={updatedAt}>
  <section class="hero-gradient">
    <div class="container-content py-10 sm:py-12">
      <nav class="text-sm" style="color: var(--color-text-secondary)"><a href="/zh/">首页</a> · 对比 / 工具 · <span style="color: var(--color-text-primary)">学费计算器</span></nav>
      <h1 class="mt-5 text-3xl sm:text-4xl lg:text-5xl text-balance" style="font-weight:800; letter-spacing:-0.022em">国际学校学费计算器</h1>
      <p class="mt-4 max-w-2xl text-base sm:text-lg" style="color: var(--color-text-secondary); line-height: 1.7;">学费 + 附加费用 9 项 + 汇率波动 + 家庭机票的总成本模拟。</p>
      <div class="mt-5"><AuthorByline locale="zh" publishedAt={publishedAt} updatedAt={updatedAt} sources="站长亲身缴费明细 + 家长社群信息" /></div>
    </div>
  </section>
  <article class="container-content py-10 max-w-3xl">
    <div class="rounded-2xl p-6" style="background: linear-gradient(135deg, var(--tint-warning) 0%, var(--tint-warning) 100%); border: 1px solid #FCD34D">
      <div class="text-xs uppercase tracking-wider" style="color: var(--color-accent-700); font-weight: 700; letter-spacing: 0.08em">✦ 核心要点</div>
      <p class="mt-3 text-base" style="color: var(--color-accent-700); line-height: 1.7; font-weight: 500">学校公布学费仅占 <strong>总成本 70-80%</strong>。注册费 · 保证金 · 校车 · CCA · 机票占余下 20-30%。家庭预算建议按学费 <strong>1.2-1.3 倍</strong> 估算。</p>
    </div>
    <section class="mt-10">
      <h2 class="text-2xl" style="font-weight:800; letter-spacing:-0.02em">学费计算器</h2>
      <TuitionCalculator client:visible locale="zh" />
    </section>
    <section class="mt-12">
      <h2 class="text-2xl" style="font-weight:800; letter-spacing:-0.02em">学费之外的 9 项附加费用 — 站长真实缴费清单</h2>
      <p class="mt-3 text-base" style="line-height:1.75">我是 David,常住吉隆坡,两个孩子在 UCSI 就读。学校官网公布的年学费,只是账单的开头。以下是我第一学期真正刷卡付出去的项目,给中国家长一个务实的心理预期:</p>
      <ul class="mt-4 space-y-2 text-base" style="line-height:1.75">
        <li><strong>报名费(注册费 Application Fee)：</strong>约 USD $200-500,一次性、不退还,递交申请时就要交。</li>
        <li><strong>入学注册金(Registration/Enrollment Fee)：</strong>入学时一次性缴纳,通常为年学费的 10-30%,金额不小。</li>
        <li><strong>可退还保证金(Refundable Deposit）：</strong>毕业或转学时退回,我这边是每个孩子约 USD $1,500。</li>
        <li><strong>设施费(Facility/Development Fee)：</strong>每年都要交,用于校舍与设备维护,约 USD $500-800。</li>
        <li><strong>EAL 英语强化课(English as Additional Language)：</strong>英语基础不足的孩子多为必修加收项,按学期计费,这一项很多家长事先不知道。</li>
        <li><strong>校车费(School Bus)：</strong>按距离计,每月约 USD $80-130,一年 10 个月。</li>
        <li><strong>餐费(Meals)：</strong>学校食堂套餐每月约 USD $150-300,可选但低年级基本都用。</li>
        <li><strong>校服(Uniform)：</strong>初次入学一次性约 USD $200/孩子,含体育服与正装。</li>
        <li><strong>考试报名费(Exam Fees)：</strong>IGCSE · A-Level · IB · SAT 等外部考试,报考时另计,高年级尤其明显。</li>
        <li><strong>回国机票(Airfare)：</strong>中国往返东南亚一家人一年约 USD $2,000-4,000,寒暑假返乡的隐形大头。</li>
      </ul>
      <p class="mt-4 text-base" style="line-height:1.75">我的实际体会:官网年学费虽然是一个数字,<strong>但第一学期实际缴费大约是它的 1.5 倍</strong>(因为报名费、注册金、保证金、校服这些一次性项目都集中在开头)。从第二学期起,一次性项目消失,费用会稳定在「学费 + 设施费 + 餐费 + CCA」的水平。所以做家庭预算时,请按年学费的 <strong>1.2-1.3 倍</strong> 留出安全线。</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl" style="font-weight:800; letter-spacing:-0.02em">常见问题</h2>
      <div class="mt-5 space-y-3">
        <details class="rounded-xl p-4" style="border:1px solid var(--color-border-light)">
          <summary class="cursor-pointer" style="font-weight:600; color: var(--val-strong)">除了学费,真正会花掉的钱有哪些?</summary>
          <p class="mt-3 text-sm" style="line-height:1.7">共 9 大项:报名费(不退,$200-500)、入学注册金(年学费 10-30%,一次性)、可退还保证金(毕业时退回)、每年设施费、EAL 英语强化、校车(每月 $80-130)、餐费(每月 $150-300)、校服、外部考试报名费,以及回国机票。通常需要在学费之外再预留 15-25% 的预算。</p>
        </details>
        <details class="rounded-xl p-4" style="border:1px solid var(--color-border-light)">
          <summary class="cursor-pointer" style="font-weight:600; color: var(--val-strong)">汇率波动对家庭负担影响有多大?</summary>
          <p class="mt-3 text-sm" style="line-height:1.7">学校用当地货币(如马来西亚 MYR)开账单,USD 或人民币的换算值会随汇率起伏。MYR 兑美元一年内可波动约 ±10%,换算成人民币时,一笔 USD $20,000 的学费可能相差上万元。若想规避汇率风险,可与学校协商一次性年付(通常有 3-5% 折扣并锁定汇率)。</p>
        </details>
        <details class="rounded-xl p-4" style="border:1px solid var(--color-border-light)">
          <summary class="cursor-pointer" style="font-weight:600; color: var(--val-strong)">学费越贵学校就一定越好吗?</summary>
          <p class="mt-3 text-sm" style="line-height:1.7">不一定。作为搬过两次校的家长,我的经验是:学费高低与教育质量并不成正比。有些高学费学校校舍老旧、本地或某一国籍学生比例偏高;也有中等预算学校在师资和英语环境上更扎实。请务必把附加费用、生活成本、师资构成一起算进去,而不是只看官网那一个学费数字。需要针对具体学校做 5 年总成本测算,欢迎加我 WeChat 一对一沟通。</p>
        </details>
      </div>
    </section>

    <section class="mt-12 card-cta">
      <h2 class="text-xl text-white" style="font-weight:500">学费 + 生活费 1:1 模拟</h2>
      <p class="mt-3 text-sm">告知子女年级 · 候选学校 · 家庭构成 · 居住区,可获 5 年总成本模拟答复。</p>
      <a href="/zh/contact/" class="mt-5 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3" style="font-weight:500">WeChat 咨询<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></a>
    </section>
    <section class="mt-10">
      <h2 class="text-xl" style="font-weight:700">相关工具</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <a href="/zh/tools/compare/" class="card text-sm block"><div class="text-primary-900" style="font-weight:500">⭐ 学校对比工具</div></a>
        <a href="/zh/tools/track-simulator/" class="card text-sm block"><div class="text-primary-900" style="font-weight:500">🎯 升学路径模拟器</div></a>
        <a href="/zh/tools/curriculum-guide/" class="card text-sm block"><div class="text-primary-900" style="font-weight:500">📚 IB vs AP vs A-Level</div></a>
        <a href="/zh/tools/calendar/" class="card text-sm block"><div class="text-primary-900" style="font-weight:500">📅 入学日历</div></a>
      </div>
    </section>
  </article>
</BaseLayout>
