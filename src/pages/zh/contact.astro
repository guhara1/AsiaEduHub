---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '免费咨询 · David(WeChat 优先)';
const description =
  '国际学校选择、转校、马来西亚 MM2H 签证等家长 1:1 咨询。WeChat 优先,站长 David 亲自答复。中文沟通顺畅。';

const WECHAT_ID = 'TODO_WECHAT_ID';
const EMAIL = 'TODO_EMAIL@asiaeduhub.com';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  inLanguage: 'zh-CN',
  about: {
    '@type': 'Person',
    name: 'David',
    contactPoint: [
      { '@type': 'ContactPoint', contactType: 'customer support', email: EMAIL, areaServed: ['CN', 'MY', 'SG'], availableLanguage: ['zh', 'ko', 'en'] },
    ],
  },
};
---
<BaseLayout title={title} description={description} jsonLd={contactSchema}>
  <section class="hero-gradient border-b" style="border-color: var(--color-border-light)">
    <div class="container-content py-10 sm:py-12 max-w-2xl">
      <p class="badge-gold mb-3">⭐ 两次转校的家长</p>
      <h1 class="text-3xl sm:text-4xl text-balance">家长 1:1 免费咨询</h1>
      <p class="mt-4 text-base text-pretty" style="color: var(--color-text-secondary); line-height: 1.65;">
        国际学校选择、转校、马来西亚 MM2H / 泰国精英签证、留学机构利用等。
        站长 David 亲自答复(中文沟通顺畅,儿时北京经历)。非广告、非营销,答复可能 1~2 日。
      </p>
    </div>
  </section>

  <section class="container-content py-10 max-w-2xl">

    {/* WeChat 우선 노출 — 사양 핵심 */}
    <div class="mt-8 rounded-xl border-2 p-6" style="border-color: var(--color-primary-900); background: var(--tint-primary)">
      <div class="flex items-start gap-5">
        <div class="shrink-0">
          {/* 운영자 WeChat QR 코드 자리. /public/wechat-qr.png 로 업로드 시 자동 표시. */}
          <div
            aria-label="WeChat QR"
            class="flex h-32 w-32 items-center justify-center rounded-lg bg-white text-xs text-[color:var(--color-text-tertiary)]"
            style="background-image: url('/wechat-qr.png'); background-size: cover; background-position: center;"
          >
            <span class="px-2 text-center" style="background: rgba(255,255,255,0.85)">
              WeChat QR<br />(待上传)
            </span>
          </div>
        </div>
        <div>
          <div class="text-xs text-primary-900">WeChat(首选)</div>
          <div class="mt-1 text-xl text-primary-900" style="font-weight:500">{WECHAT_ID}</div>
          <p class="mt-2 text-sm text-[color:var(--color-text-secondary)]">
            扫描二维码,或在 WeChat 搜索上方 ID 添加站长。请简述:孩子年级、关注国家、预算范围。
          </p>
        </div>
      </div>
    </div>

    <div class="mt-6 rounded-lg border p-5" style="border-color: var(--color-border-light)">
      <div class="text-xs text-[color:var(--color-text-secondary)]">邮箱</div>
      <a class="mt-1 block text-lg text-primary-900" style="font-weight:500" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </div>

    <div class="mt-6 rounded-lg p-5" style="background: var(--color-bg-secondary)">
      <p class="text-sm">
        韩文咨询请前往 <a href="/contact/">KakaoTalk 页面</a>。
      </p>
    </div>

    <section class="mt-12">
      <h2 class="text-2xl" style="font-weight:800; letter-spacing:-0.02em">可以咨询什么</h2>
      <ul class="mt-4 space-y-2 text-sm" style="color: var(--color-text-primary); line-height: 1.7; list-style: disc; padding-left: 1.25rem;">
        <li><strong>选校</strong> — 按孩子年级 · 性格 · 预算缩小候选(含华人/本地比例、课程、通学)</li>
        <li><strong>转校</strong> — 基于两次转校经验的时机 · 费用 · 流程 · 清单</li>
        <li><strong>家长居留</strong> — 马来西亚 MM2H · 学生/监护人签证、泰国精英签证等孩子留学时父母的居留方式</li>
        <li><strong>总费用</strong> — 表面学费之外的附加费用 · 生活费在内的现实预算</li>
        <li><strong>居住地</strong> — 吉隆坡学区(Mont Kiara · Desa ParkCity 等)与通学动线</li>
        <li><strong>本地华人 vs 中国大陆</strong> — 学生构成差异与择校含义(中文家庭关心的点)</li>
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl" style="font-weight:800; letter-spacing:-0.02em">咨询前准备这些信息</h2>
      <ul class="mt-4 space-y-2 text-sm" style="color: var(--color-text-primary); line-height: 1.7; list-style: disc; padding-left: 1.25rem;">
        <li>孩子年龄 · 年级、孩子人数</li>
        <li>关注的国家 · 城市(未定也没关系)</li>
        <li>年度预算范围</li>
        <li>移居 · 入学的期望时间</li>
        <li>孩子目前的英语水平</li>
      </ul>
      <p class="mt-3 text-sm" style="color: var(--color-text-secondary); line-height: 1.7;">
        提供这些信息,我就能给出<strong>贴合您家情况的答复</strong>,而不是泛泛而谈。
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl" style="font-weight:800; letter-spacing:-0.02em">咨询方式 · 答复时间</h2>
      <p class="mt-3 text-sm" style="color: var(--color-text-primary); line-height: 1.7;">
        通过 WeChat · 邮箱由站长 David <strong>亲自 1:1 答复</strong>。<strong>免费</strong>,非广告 · 非营销。
        答复通常需 <strong>1~2 日</strong>(受当地时差 · 学校走访安排影响)。可用中文 · 韩文 · 英文沟通。
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl" style="font-weight:800; letter-spacing:-0.02em">常见问题</h2>
      <div class="mt-4 space-y-4">
        <div>
          <h3 class="text-base text-primary-900" style="font-weight:600">咨询收费吗?</h3>
          <p class="mt-1 text-sm" style="color: var(--color-text-secondary); line-height: 1.7;">不收费。作为先走过同一条路的家长,分享经验是初衷。</p>
        </div>
        <div>
          <h3 class="text-base text-primary-900" style="font-weight:600">会推荐具体学校吗?</h3>
          <p class="mt-1 text-sm" style="color: var(--color-text-secondary); line-height: 1.7;">提供与广告无关的<strong>家长视角分析</strong>。编辑与广告分离的原则见 <a href="/zh/editorial-policy/" class="text-primary-700 underline">编辑方针</a>。</p>
        </div>
        <div>
          <h3 class="text-base text-primary-900" style="font-weight:600">中文沟通没问题吗?</h3>
          <p class="mt-1 text-sm" style="color: var(--color-text-secondary); line-height: 1.7;">没问题。站长儿时在北京生活,可全程中文沟通,WeChat 优先。</p>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>
