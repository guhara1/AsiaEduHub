---
/**
 * 좌측 고정 광고 슬롯 (250×320) — '광고문의' 텔레그램 연결.
 *
 * - 실제 광고주 소재를 동일 위치·사이즈(250×320)로 그대로 교체 가능.
 *   creative 를 넘기면 배너(이미지/텍스트)로, 없으면 '광고문의' 폴백으로 표시.
 * - 슬롯 크기는 항상 250×320 고정 → CLS=0, 광고주 소재 규격 일관.
 * - ≥1600px(콘텐츠 컬럼 1152px 좌측 여백 확보) 화면: 250×320 배너 노출.
 * - 그 이하·모바일: 본문 가림 방지를 위해 컴팩트 세로 탭으로 대체(동일 링크).
 */
import { resolveLocale, type Locale } from '../lib/i18n';
import type { AdCreative } from '../lib/ads';

export interface Props {
  /** 250×320 좌측 슬롯 광고 소재. 없으면 '광고문의' 폴백 표시. */
  creative?: AdCreative;
}

const { creative } = Astro.props;
const locale: Locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const TG = 'https://t.me/googleseolab';

const T = {
  ko: {
    tab: '광고문의',
    badge: '광고 문의',
    headline: '이 자리에 광고하세요',
    body: '한·중 학부모가 찾는 동남아 국제학교 정보 허브',
    p1: '유학원 · 학교 · MM2H 에이전시',
    p2: '배너 · CPL · 제휴 문의 환영',
    p3: '두 번 옮긴 학부모가 직접 운영',
    cta: '텔레그램으로 문의',
    sponsored: 'SPONSORED',
    aria: '광고문의 텔레그램으로 연결',
  },
  zh: {
    tab: '广告咨询',
    badge: '广告咨询',
    headline: '在此投放广告',
    body: '韩·中家长关注的东南亚国际学校信息平台',
    p1: '留学中介 · 学校 · MM2H 代理',
    p2: '横幅 · CPL · 合作咨询',
    p3: '两次转校家长亲自运营',
    cta: 'Telegram 咨询',
    sponsored: '赞助',
    aria: '广告咨询 Telegram',
  },
}[locale];

const plane =
  'M21.5 4.2 2.9 11.5c-1 .4-1 1.7 0 2l4.8 1.5 11.2-9.7c.3-.3.7.1.5.4l-9.1 9.9v3.6c0 .8 1 .9 1.4.3l2.6-2.5 4.7 3.5c.5.4 1.3.1 1.5-.6l3-15.9c.2-.8-.6-1.5-1.3-1.2z';
---
{/* 250×320 좌측 광고 슬롯 — ≥1600px 노출. 실제 광고주 소재도 동일 위치·사이즈. */}
<aside
  class="hidden min-[1600px]:block fixed left-0 top-1/2 z-40 -translate-y-1/2"
  style="width:250px"
  aria-label={T.badge}
>
  <div
    class="mb-1 pl-1 text-[10px] uppercase tracking-wide text-[color:var(--color-text-tertiary)]"
    style="height:16px;line-height:16px"
  >
    {creative ? T.sponsored : T.badge}
  </div>

  {creative ? (
    <a
      href={creative.href}
      target="_blank"
      rel="sponsored noopener"
      class="block overflow-hidden rounded-xl border shadow-lg"
      style="width:250px;height:320px;border-color:var(--color-border-light);background:#fff"
      aria-label={creative.alt}
    >
      {creative.image_src ? (
        <img
          src={creative.image_src}
          alt={creative.alt}
          width="250"
          height="320"
          loading="lazy"
          decoding="async"
          class="block h-full w-full object-cover"
        />
      ) : (
        <div class="flex h-full flex-col justify-center p-4">
          {creative.headline && (
            <strong class="text-base text-primary-900" style="font-weight:500">{creative.headline}</strong>
          )}
          {creative.body && (
            <p class="mt-1 text-sm text-[color:var(--color-text-secondary)]">{creative.body}</p>
          )}
          <p class="mt-2 text-[10px] text-[color:var(--color-text-tertiary)]">{creative.sponsor}</p>
        </div>
      )}
    </a>
  ) : (
    <a
      href={TG}
      target="_blank"
      rel="noopener"
      aria-label={T.aria}
      class="group flex flex-col overflow-hidden rounded-xl border bg-white shadow-lg transition-shadow hover:shadow-xl"
      style="width:250px;height:320px;border-color:var(--color-border-light)"
    >
      <div class="flex items-center gap-2 px-4 py-3 text-white" style="background:var(--color-primary-900)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0"><path d={plane} /></svg>
        <span class="text-sm tracking-wide" style="font-weight:500">{T.badge}</span>
      </div>
      <div class="flex flex-1 flex-col p-4">
        <strong class="text-lg leading-snug text-primary-900" style="font-weight:500">{T.headline}</strong>
        <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-text-secondary)]">{T.body}</p>
        <ul class="mt-3 space-y-1.5 text-xs text-[color:var(--color-text-secondary)]">
          <li class="flex gap-1.5"><span style="color:var(--color-accent-500)">●</span><span>{T.p1}</span></li>
          <li class="flex gap-1.5"><span style="color:var(--color-accent-500)">●</span><span>{T.p2}</span></li>
          <li class="flex gap-1.5"><span style="color:var(--color-accent-500)">●</span><span>{T.p3}</span></li>
        </ul>
        <span
          class="mt-auto inline-flex items-center justify-center gap-1.5 rounded-lg px-4 py-2.5 text-sm text-white transition-transform group-hover:-translate-y-0.5"
          style="background:var(--color-primary-900);font-weight:500"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={plane} /></svg>
          {T.cta}
        </span>
      </div>
    </a>
  )}
</aside>

{/* 좁은 화면·모바일 — 컴팩트 세로 탭 (본문 가림 최소화, 동일 링크) */}
<a
  href={TG}
  target="_blank"
  rel="noopener"
  aria-label={T.aria}
  class="ad-inquiry-tab min-[1600px]:hidden fixed left-0 top-1/2 z-40 -translate-y-1/2 flex flex-col items-center gap-1.5 rounded-r-xl px-1.5 py-3 text-white shadow-lg transition-transform hover:translate-x-1"
  style="background: var(--color-primary-900)"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0"><path d={plane} /></svg>
  <span class="text-xs tracking-wide" style="writing-mode: vertical-rl; font-weight: 500; letter-spacing: 0.05em">{T.tab}</span>
</a>
