---
/**
 * 좌측 고정 광고 슬롯 (표준 스카이스크래퍼 160×600) + 좁은 화면용 컴팩트 탭 — '광고문의' 텔레그램 연결.
 *
 * - 실제 광고주 소재를 동일 규격(160×600)으로 그대로 교체 가능.
 * - ≥1500px: 160×600 스카이스크래퍼(좌측 여백, 본문 안 가림).
 * - 그 이하·모바일: 컴팩트 세로 탭(스크롤하며 읽을 수 있음).
 * - 다크모드: ad-navy/ad-surface 클래스로 배경 대비 확보(네이비가 어두운 배경에 묻히지 않게 밝은 블루로).
 */
import { resolveLocale, type Locale } from '../lib/i18n';
import type { AdCreative } from '../lib/ads';

export interface Props {
  /** 160×600 좌측 슬롯 광고 소재. 없으면 '광고문의' 폴백 표시. */
  creative?: AdCreative;
}

const { creative } = Astro.props;
const locale: Locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const TG = 'https://t.me/googleseolab';

const T = {
  ko: {
    tab: '광고문의',
    badge: '광고 문의',
    headline: '이 자리에 광고하세요',
    body: '한·중 학부모가 찾는 동남아 국제학교 정보 허브',
    p1: '유학원 · 학교 · MM2H',
    p2: '배너 · CPL · 제휴 문의',
    cta: '텔레그램 문의',
    sponsored: 'SPONSORED',
    aria: '광고문의 텔레그램으로 연결',
  },
  zh: {
    tab: '广告咨询',
    badge: '广告咨询',
    headline: '在此投放广告',
    body: '韩·中家长关注的东南亚国际学校信息平台',
    p1: '留学中介 · 学校 · MM2H',
    p2: '横幅 · CPL · 合作咨询',
    cta: 'Telegram 咨询',
    sponsored: '赞助',
    aria: '广告咨询 Telegram',
  },
}[locale];

const plane =
  'M21.5 4.2 2.9 11.5c-1 .4-1 1.7 0 2l4.8 1.5 11.2-9.7c.3-.3.7.1.5.4l-9.1 9.9v3.6c0 .8 1 .9 1.4.3l2.6-2.5 4.7 3.5c.5.4 1.3.1 1.5-.6l3-15.9c.2-.8-.6-1.5-1.3-1.2z';
---
{/* 160×600 좌측 광고 슬롯 — ≥1500px 노출. 실제 광고주 소재도 동일 위치·사이즈. */}
<aside class="hidden min-[1500px]:block fixed left-4 top-24 z-40" aria-label={T.badge}>
  {creative ? (
    <a
      href={creative.href}
      target="_blank"
      rel="sponsored noopener"
      class="ad-surface block overflow-hidden rounded-xl border shadow-lg"
      style="box-sizing:border-box;width:160px;height:600px;border-color:var(--color-border-light);background:#fff"
      aria-label={creative.alt}
    >
      {creative.image_src ? (
        <img src={creative.image_src} alt={creative.alt} width="160" height="600" loading="lazy" decoding="async" class="block h-full w-full object-cover" />
      ) : (
        <div class="flex h-full flex-col justify-center p-3 text-center">
          {creative.headline && <strong class="text-sm text-primary-900" style="font-weight:500">{creative.headline}</strong>}
          {creative.body && <p class="mt-1 text-xs text-[color:var(--color-text-secondary)]">{creative.body}</p>}
          <p class="mt-2 text-[10px] text-[color:var(--color-text-tertiary)]">{creative.sponsor}</p>
        </div>
      )}
    </a>
  ) : (
    <a
      href={TG}
      target="_blank"
      rel="noopener"
      aria-label={T.aria}
      class="ad-surface group flex flex-col overflow-hidden rounded-xl border bg-white shadow-lg transition-shadow hover:shadow-xl"
      style="box-sizing:border-box;width:160px;height:600px;border-color:var(--color-border-light)"
    >
      <div class="ad-navy flex items-center justify-center gap-1.5 px-2 py-3">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0"><path d={plane} /></svg>
        <span class="text-xs tracking-wide" style="font-weight:500">{T.badge}</span>
      </div>
      <div class="flex flex-1 flex-col justify-center p-4 text-center">
        <strong class="text-base leading-snug text-primary-900" style="font-weight:500">{T.headline}</strong>
        <p class="mt-3 text-xs leading-relaxed text-[color:var(--color-text-secondary)]">{T.body}</p>
        <ul class="mt-4 space-y-2 text-left text-[11px] text-[color:var(--color-text-secondary)]">
          <li class="flex gap-1.5"><span style="color:var(--color-accent-500)">●</span><span>{T.p1}</span></li>
          <li class="flex gap-1.5"><span style="color:var(--color-accent-500)">●</span><span>{T.p2}</span></li>
        </ul>
        <span class="ad-navy mt-6 inline-flex items-center justify-center gap-1.5 rounded-lg px-3 py-2.5 text-xs transition-transform group-hover:-translate-y-0.5" style="font-weight:500">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={plane} /></svg>
          {T.cta}
        </span>
      </div>
    </a>
  )}
</aside>

{/* 좁은 화면·모바일 — 컴팩트 세로 탭 (스크롤하며 읽기 가능, 동일 링크). 다크모드 대비는 ad-navy 로 확보 */}
<a
  href={TG}
  target="_blank"
  rel="noopener"
  aria-label={T.aria}
  class="ad-inquiry-tab ad-navy min-[1500px]:hidden fixed left-0 top-1/2 z-40 -translate-y-1/2 flex flex-col items-center gap-1.5 rounded-r-xl px-1.5 py-3 shadow-lg transition-transform hover:translate-x-1"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0"><path d={plane} /></svg>
  <span class="text-xs tracking-wide" style="writing-mode: vertical-rl; font-weight: 500; letter-spacing: 0.05em">{T.tab}</span>
</a>
