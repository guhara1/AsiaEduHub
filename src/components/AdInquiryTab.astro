---
/**
 * 좌측 고정 '광고문의' 텔레그램 배너.
 * - PC·모바일 전 화면 상시 노출 (좌측 가장자리, 세로 중앙).
 * - 세로 탭 형태라 폭이 좁아 모바일에서도 본문을 거의 가리지 않음.
 * - 자체 광고문의 CTA → 텔레그램(t.me/googleseolab).
 */
import { resolveLocale, type Locale } from '../lib/i18n';

const locale: Locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const label = locale === 'ko' ? '광고문의' : '广告咨询';
const aria = locale === 'ko' ? '광고문의 텔레그램으로 연결' : '广告咨询 Telegram';
---
<a
  href="https://t.me/googleseolab"
  target="_blank"
  rel="noopener"
  aria-label={aria}
  class="ad-inquiry-tab fixed left-0 top-1/2 z-40 -translate-y-1/2 flex flex-col items-center gap-1.5 rounded-r-xl px-1.5 py-3 text-white shadow-lg transition-transform hover:translate-x-1"
  style="background: var(--color-primary-900)"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
    <path d="M21.5 4.2 2.9 11.5c-1 .4-1 1.7 0 2l4.8 1.5 11.2-9.7c.3-.3.7.1.5.4l-9.1 9.9v3.6c0 .8 1 .9 1.4.3l2.6-2.5 4.7 3.5c.5.4 1.3.1 1.5-.6l3-15.9c.2-.8-.6-1.5-1.3-1.2z"/>
  </svg>
  <span class="text-xs tracking-wide" style="writing-mode: vertical-rl; font-weight: 500; letter-spacing: 0.05em">{label}</span>
</a>
