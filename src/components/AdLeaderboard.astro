---
/**
 * 본문 최상단 리더보드 광고 슬롯 (728×150) — '광고문의' 텔레그램 연결.
 *
 * - 실제 광고주 소재를 동일 규격(728×150)으로 그대로 교체 가능.
 *   creative 넘기면 배너, 없으면 '광고문의' 폴백.
 * - 데스크톱: 정확히 728×150. 모바일: max-width 728 + aspect-ratio 유지로 자동 리사이징.
 * - 전 페이지 <main> 최상단에 삽입.
 */
import { resolveLocale, type Locale } from '../lib/i18n';
import type { AdCreative } from '../lib/ads';

export interface Props {
  creative?: AdCreative;
}

const { creative } = Astro.props;
const locale: Locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const TG = 'https://t.me/googleseolab';

const T = {
  ko: {
    badge: '광고 문의',
    headline: '이 자리에 광고하세요',
    body: '한·중 학부모가 찾는 동남아 국제학교 정보 허브',
    cta: '텔레그램으로 문의',
    sponsored: 'SPONSORED',
    aria: '광고문의 텔레그램으로 연결',
  },
  zh: {
    badge: '广告咨询',
    headline: '在此投放广告',
    body: '韩·中家长关注的东南亚国际学校信息平台',
    cta: 'Telegram 咨询',
    sponsored: '赞助',
    aria: '广告咨询 Telegram',
  },
}[locale];

const plane =
  'M21.5 4.2 2.9 11.5c-1 .4-1 1.7 0 2l4.8 1.5 11.2-9.7c.3-.3.7.1.5.4l-9.1 9.9v3.6c0 .8 1 .9 1.4.3l2.6-2.5 4.7 3.5c.5.4 1.3.1 1.5-.6l3-15.9c.2-.8-.6-1.5-1.3-1.2z';
---
<div class="container-content pt-4" aria-label={T.badge}>
  {creative ? (
    <a
      href={creative.href}
      target="_blank"
      rel="sponsored noopener"
      class="mx-auto block w-full overflow-hidden rounded-lg border shadow-sm"
      style="max-width:728px;aspect-ratio:728/150;border-color:var(--color-border-light);background:#fff"
      aria-label={creative.alt}
    >
      {creative.image_src ? (
        <img src={creative.image_src} alt={creative.alt} width="728" height="150" loading="lazy" decoding="async" class="block h-full w-full object-cover" />
      ) : (
        <div class="flex h-full w-full items-center justify-center px-4 text-center">
          <span class="text-primary-900" style="font-weight:500">{creative.headline ?? creative.alt}</span>
        </div>
      )}
    </a>
  ) : (
    <a
      href={TG}
      target="_blank"
      rel="noopener"
      aria-label={T.aria}
      class="group mx-auto flex w-full items-center justify-between gap-3 overflow-hidden rounded-lg border-2 border-dashed px-[3%] transition-colors hover:border-primary-700"
      style="max-width:728px;aspect-ratio:728/150;border-color:var(--color-border-medium);background:var(--color-bg-secondary)"
    >
      <span class="flex min-w-0 items-center gap-2.5 text-left">
        <span class="grid shrink-0 place-items-center rounded-full text-white" style="width:clamp(28px,6vw,40px);height:clamp(28px,6vw,40px);background:var(--color-primary-900)">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:55%;height:55%"><path d={plane} /></svg>
        </span>
        <span class="min-w-0">
          <span class="block truncate text-primary-900" style="font-weight:500;font-size:clamp(0.85rem,2.6vw,1.15rem)">{T.headline}</span>
          <span class="block truncate text-[color:var(--color-text-secondary)]" style="font-size:clamp(0.65rem,1.9vw,0.9rem)">{T.body}</span>
        </span>
      </span>
      <span
        class="inline-flex shrink-0 items-center gap-1.5 rounded-lg text-white transition-transform group-hover:-translate-y-0.5"
        style="background:var(--color-primary-900);font-weight:500;font-size:clamp(0.7rem,2vw,0.9rem);padding:clamp(0.35rem,1.4vw,0.7rem) clamp(0.6rem,2.4vw,1.1rem)"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:1em;height:1em"><path d={plane} /></svg>
        <span class="whitespace-nowrap">{T.cta}</span>
      </span>
    </a>
  )}
</div>
